import { Button, CheckBox, ComboBox, LineEdit, ListView, VerticalBox, HorizontalBox, StandardButton, Palette } from "std-widgets.slint";

export struct EntryInfo {
    name: string,
    is-totp: bool,
}

export component MainWindow inherits Window {
    title: "cybercuris";
    min-width: 420px;
    min-height: 480px;

    in property <[EntryInfo]> entries;
    in property <string> status;
    in-out property <bool> locked: true;
    in property <bool> needs-init: false;
    in-out property <bool> show-add-password: false;
    in-out property <bool> show-edit-password: false;
    in-out property <bool> show-settings: false;
    in-out property <bool> add-is-totp: false;
    in-out property <bool> edit-is-totp: false;
    in-out property <bool> add-show-more: false;
    in-out property <bool> edit-show-more: false;
    in-out property <int> add-algorithm-index: 0;
    in-out property <string> add-digits: "6";
    in-out property <string> add-period: "30";
    in-out property <bool> add-uri-detected: false;
    in-out property <string> edit-original-name;
    in-out property <string> filter-text;
    in-out property <int> selected-index: 0;
    in property <string> quit-shortcut-key: "x";
    in property <string> hide-shortcut-key: "h";
    in property <string> settings-timeout-minutes;

    callback store-password(name: string, password: string) -> bool;
    callback store-totp(name: string, secret: string, algorithm: string, digits: string, period: string) -> bool;
    callback totp-secret-changed(secret: string);
    callback edit-password(old-name: string, new-name: string, new-password: string);
    callback edit-totp(old-name: string, new-name: string, secret: string, algorithm: string, digits: string, period: string);
    callback copy-password(name: string);
    callback remove-password(name: string);
    callback refresh();
    callback hide-window();
    callback lock();
    callback exit();
    callback unlock-password(password: string);
    callback set-init-password(p1: string, p2: string);
    callback filter-changed(string);
    callback save-settings(timeout-minutes: string, quit-key: string, hide-key: string);
    callback backup-pressed();
    callback restore-pressed();

    FocusScope {
        capture-key-pressed(event) => {
            if event.text == root.quit-shortcut-key && event.modifiers.control {
                root.exit();
                return accept;
            }
            if event.text == root.hide-shortcut-key && event.modifiers.control {
                root.hide-window();
                return accept;
            }
            reject
        }

        key-pressed(event) => {
            if event.text == "\u{001b}" {
                if root.filter-text == "" {
                    root.hide-window();
                } else {
                    root.filter-text = "";
                    root.filter-changed("");
                }
                return accept;
            }
            reject
        }

        if root.locked : VerticalBox {
            padding: 12px;
            spacing: 8px;
            alignment: center;

            if root.needs-init : VerticalBox {
                Text {
                    text: "Set a password to protect your main key.\nThis password will be required each time\nyou unlock your password store.";
                    font-size: 14px;
                }

                pass1 := LineEdit {
                    placeholder-text: "New password";
                    input-type: password;
                    init => { pass1.focus(); }
                    accepted => { pass2.focus(); }
                }

                pass2 := LineEdit {
                    placeholder-text: "Confirm password";
                    input-type: password;
                    accepted => { root.set-init-password(pass1.text, pass2.text); }
                }

                Button {
                    text: "Set Password";
                    primary: true;
                    clicked => { root.set-init-password(pass1.text, pass2.text); }
                }

                Text {
                    text: root.status;
                    color: #d04040;
                    wrap: word-wrap;
                    font-size: 12px;
                }
            }

            if !root.needs-init : VerticalBox {
                Text {
                    text: "Enter main key password:";
                    font-size: 14px;
                }

                unlock-pass := LineEdit {
                    placeholder-text: "Password";
                    input-type: password;
                    init => { unlock-pass.focus(); }
                    accepted => {
                        root.unlock-password(unlock-pass.text);
                        unlock-pass.text = "";
                    }
                }

                Text {
                    text: root.status;
                    color: #d04040;
                    wrap: word-wrap;
                    font-size: 12px;
                }
            }
        }

        if !root.locked : VerticalBox {
            padding: 8px;
            spacing: 4px;

            Text {
                text: "Stored Passwords & TOTPs";
                font-size: 16px;
                font-weight: 700;
            }

            search := LineEdit {
                placeholder-text: "Search passwords...";
                text <=> root.filter-text;
                init => { search.focus(); }
                edited => { root.filter-changed(root.filter-text); }
                key-pressed(event) => {
                    if event.text == "\u{0009}" && !event.modifiers.shift {
                        if root.selected-index + 1 < root.entries.length {
                            root.selected-index += 1;
                        }
                        return accept;
                    }
                    if event.text == "\u{0019}" || (event.text == "\u{0009}" && event.modifiers.shift) {
                        if root.selected-index > 0 {
                            root.selected-index -= 1;
                        }
                        return accept;
                    }
                    if event.text == "\u{f701}" {
                        if root.selected-index + 1 < root.entries.length {
                            root.selected-index += 1;
                        }
                        return accept;
                    }
                    if event.text == "\u{f700}" {
                        if root.selected-index > 0 {
                            root.selected-index -= 1;
                        }
                        return accept;
                    }
                    reject
                }
                accepted => {
                    if root.entries.length > 0 {
                        root.copy-password(root.entries[root.selected-index].name);
                    }
                }
            }

            ListView {
                vertical-stretch: 1;
                for entry[idx] in root.entries: Rectangle {
                    height: row.preferred-height;
                    background: idx == root.selected-index ? #1564c020 : transparent;
                    TouchArea {
                        clicked => { root.selected-index = idx; }
                    }
                    row := HorizontalBox {
                        padding: 2px;
                        Text {
                            text: entry.is-totp ? entry.name + " (TOTP)" : entry.name;
                            horizontal-stretch: 1;
                            overflow: elide;
                            color: idx == root.selected-index ? #1564c0 : Palette.foreground;
                            font-size: 1.5rem;
                        }
                        Button {
                            text: "Copy";
                            clicked => {
                                root.copy-password(entry.name);
                            }
                        }
                        Button {
                            text: "Edit";
                            clicked => {
                                root.edit-original-name = entry.name;
                                root.edit-is-totp = entry.is-totp;
                                root.edit-show-more = false;
                                root.show-add-password = false;
                                root.show-settings = false;
                                root.show-edit-password = true;
                            }
                        }
                        Button {
                            text: "Remove";
                            clicked => {
                                root.remove-password(entry.name);
                            }
                        }
                    }
                }
            }

            if root.show-add-password : VerticalBox {
                spacing: 4px;

                name-edit := LineEdit {
                    placeholder-text: "Name";
                    init => { name-edit.focus(); }
                }

                totp-check := CheckBox {
                    text: "TOTP";
                    checked <=> root.add-is-totp;
                }

                password-edit := LineEdit {
                    placeholder-text: "Password";
                    input-type: password;
                    visible: !root.add-is-totp;
                    accepted => {
                        if !root.add-is-totp && root.store-password(name-edit.text, password-edit.text) {
                            password-edit.text = "";
                            root.show-add-password = false;
                            root.filter-text = "";
                            search.focus();
                        }
                    }
                }

                secret-edit := LineEdit {
                    placeholder-text: "Secret (base32 or otpauth:// URI)";
                    input-type: password;
                    visible: root.add-is-totp;
                    edited => { root.totp-secret-changed(secret-edit.text); }
                }

                Button {
                    text: root.add-show-more ? "Less" : "More";
                    visible: root.add-is-totp && !root.add-uri-detected;
                    clicked => { root.add-show-more = !root.add-show-more; }
                }

                algo-combo := ComboBox {
                    visible: root.add-is-totp && !root.add-uri-detected && root.add-show-more;
                    model: ["sha1", "sha256", "sha512"];
                    current-index <=> root.add-algorithm-index;
                }

                HorizontalBox {
                    spacing: 4px;
                    visible: root.add-is-totp && !root.add-uri-detected && root.add-show-more;

                    VerticalBox {
                        spacing: 2px;
                        Text {
                            text: "Digits";
                            font-size: 12px;
                        }
                        digits-edit := LineEdit {
                            placeholder-text: "6-8";
                            text <=> root.add-digits;
                        }
                    }

                    VerticalBox {
                        spacing: 2px;
                        Text {
                            text: "Interval(seconds)";
                            font-size: 12px;
                        }
                        period-edit := LineEdit {
                            placeholder-text: "Seconds";
                            text <=> root.add-period;
                        }
                    }
                }

                HorizontalBox {
                    alignment: end;
                    spacing: 4px;

                    Button {
                        text: "Cancel";
                        clicked => {
                            root.add-is-totp = false;
                            root.add-uri-detected = false;
                            root.add-show-more = false;
                            root.add-algorithm-index = 0;
                            root.add-digits = "6";
                            root.add-period = "30";
                            root.show-add-password = false;
                            root.filter-text = "";
                            search.focus();
                        }
                    }
                    Button {
                        text: "Store";
                        primary: true;
                        clicked => {
                            if root.add-is-totp {
                                if root.store-totp(name-edit.text, secret-edit.text, algo-combo.current-value, digits-edit.text, period-edit.text) {
                                    secret-edit.text = "";
                                    root.add-is-totp = false;
                                    root.add-uri-detected = false;
                                    root.add-show-more = false;
                                    root.add-algorithm-index = 0;
                                    root.add-digits = "6";
                                    root.add-period = "30";
                                    root.show-add-password = false;
                                    root.filter-text = "";
                                    search.focus();
                                }
                            } else {
                                if root.store-password(name-edit.text, password-edit.text) {
                                    password-edit.text = "";
                                    root.show-add-password = false;
                                    root.filter-text = "";
                                    search.focus();
                                }
                            }
                        }
                    }
                }
            }

            if root.show-edit-password : VerticalBox {
                spacing: 4px;

                edit-name-edit := LineEdit {
                    placeholder-text: "Name";
                    init => {
                        edit-name-edit.text = root.edit-original-name;
                        edit-name-edit.focus();
                    }
                }

                edit-password-edit := LineEdit {
                    placeholder-text: "Password (leave empty to keep current)";
                    input-type: password;
                    visible: !root.edit-is-totp;
                    accepted => {
                        if !root.edit-is-totp {
                            root.edit-password(root.edit-original-name, edit-name-edit.text, edit-password-edit.text);
                            edit-password-edit.text = "";
                            root.show-edit-password = false;
                            root.filter-text = "";
                            search.focus();
                        }
                    }
                }

                edit-secret-edit := LineEdit {
                    placeholder-text: "Secret (leave empty to keep current)";
                    input-type: password;
                    visible: root.edit-is-totp;
                }

                Button {
                    text: root.edit-show-more ? "Less" : "More";
                    visible: root.edit-is-totp;
                    clicked => { root.edit-show-more = !root.edit-show-more; }
                }

                edit-algo-combo := ComboBox {
                    visible: root.edit-is-totp && root.edit-show-more;
                    model: ["sha1", "sha256", "sha512"];
                    current-index: 0;
                }

                HorizontalBox {
                    spacing: 4px;
                    visible: root.edit-is-totp && root.edit-show-more;

                    VerticalBox {
                        spacing: 2px;
                        Text {
                            text: "Digits";
                            font-size: 12px;
                        }
                        edit-digits-edit := LineEdit {
                            placeholder-text: "6-8";
                            text: "6";
                        }
                    }

                    VerticalBox {
                        spacing: 2px;
                        Text {
                            text: "Interval(seconds)";
                            font-size: 12px;
                        }
                        edit-period-edit := LineEdit {
                            placeholder-text: "Seconds";
                            text: "30";
                        }
                    }
                }

                HorizontalBox {
                    alignment: end;
                    spacing: 4px;

                    Button {
                        text: "Cancel";
                        clicked => {
                            root.edit-show-more = false;
                            root.show-edit-password = false;
                            root.filter-text = "";
                            search.focus();
                        }
                    }
                    Button {
                        text: "Save";
                        primary: true;
                        clicked => {
                            if root.edit-is-totp {
                                root.edit-totp(root.edit-original-name, edit-name-edit.text, edit-secret-edit.text, edit-algo-combo.current-value, edit-digits-edit.text, edit-period-edit.text);
                            } else {
                                root.edit-password(root.edit-original-name, edit-name-edit.text, edit-password-edit.text);
                                edit-password-edit.text = "";
                            }
                            root.edit-show-more = false;
                            root.show-edit-password = false;
                            root.filter-text = "";
                            search.focus();
                        }
                    }
                }
            }

            if root.show-settings : VerticalBox {
                spacing: 4px;

                HorizontalBox {
                    spacing: 4px;
                    Text {
                        text: "Unlock timeout (minutes):";
                        vertical-alignment: center;
                    }
                    timeout-edit := LineEdit {
                        horizontal-stretch: 1;
                        init => {
                            timeout-edit.text = root.settings-timeout-minutes;
                            timeout-edit.focus();
                        }
                    }
                }

                HorizontalBox {
                    spacing: 4px;
                    Text {
                        text: "Quit shortcut:  Ctrl +";
                        vertical-alignment: center;
                    }
                    quit-key-edit := LineEdit {
                        horizontal-stretch: 1;
                        init => { quit-key-edit.text = root.quit-shortcut-key; }
                    }
                }

                HorizontalBox {
                    spacing: 4px;
                    Text {
                        text: "Hide shortcut:  Ctrl +";
                        vertical-alignment: center;
                    }
                    hide-key-edit := LineEdit {
                        horizontal-stretch: 1;
                        init => { hide-key-edit.text = root.hide-shortcut-key; }
                    }
                }

                Text {
                    text: "Data";
                    font-size: 14px;
                    font-weight: 600;
                }

                HorizontalBox {
                    spacing: 4px;
                    alignment: start;
                    Button {
                        text: "Backup";
                        clicked => { root.backup-pressed(); }
                    }
                    Button {
                        text: "Restore";
                        clicked => { root.restore-pressed(); }
                    }
                }

                HorizontalBox {
                    alignment: end;
                    spacing: 4px;

                    Button {
                        text: "Cancel";
                        clicked => {
                            root.show-settings = false;
                            search.focus();
                        }
                    }
                    Button {
                        text: "Save";
                        primary: true;
                        clicked => {
                            root.save-settings(timeout-edit.text, quit-key-edit.text, hide-key-edit.text);
                            root.show-settings = false;
                            search.focus();
                        }
                    }
                }
            }

            Text {
                text: root.status;
                wrap: word-wrap;
                color: root.status == "" ? transparent : #a0a0a0;
            }

            HorizontalBox {
                alignment: start;
                spacing: 4px;

                Button {
                    text: "Add";
                    clicked => {
                        root.add-is-totp = false;
                        root.add-uri-detected = false;
                        root.add-show-more = false;
                        root.add-algorithm-index = 0;
                        root.add-digits = "6";
                        root.add-period = "30";
                        root.show-edit-password = false;
                        root.show-settings = false;
                        root.show-add-password = true;
                    }
                }
                Button {
                    text: "Settings";
                    clicked => {
                        root.show-add-password = false;
                        root.show-edit-password = false;
                        root.show-settings = true;
                    }
                }
                Button {
                    text: "Lock";
                    clicked => { root.lock(); }
                }
                Button {
                    text: "Hide";
                    clicked => { root.hide-window(); }
                }
                Button {
                    text: "Exit";
                    clicked => { root.exit(); }
                }
            }
        }
    }
}

export component UnlockDialog inherits Dialog {
    title: "Unlock Cybercuris";

    in-out property <string> password-text;
    callback accepted;

    forward-focus: password-input;

    VerticalBox {
        padding: 12px;
        spacing: 8px;

        Text {
            text: "Enter main key password:";
            font-size: 14px;
        }

        password-input := LineEdit {
            placeholder-text: "Password";
            input-type: password;
            text <=> root.password-text;
            accepted => { root.accepted(); }
        }
    }

    StandardButton { kind: ok; }
    StandardButton { kind: cancel; }
}

export component SetPasswordDialog inherits Dialog {
    title: "Initialize Cybercuris";

    in-out property <string> password1;
    in-out property <string> password2;
    callback accepted;

    forward-focus: pass1;

    VerticalBox {
        padding: 12px;
        spacing: 8px;

        Text {
            text: "Set a password to protect your main key.\nThis password will be required each time\nyou unlock your password store.";
            font-size: 14px;
        }

        pass1 := LineEdit {
            placeholder-text: "New password";
            input-type: password;
            text <=> root.password1;
            accepted => { pass2.focus(); }
        }

        pass2 := LineEdit {
            placeholder-text: "Confirm password";
            input-type: password;
            text <=> root.password2;
            accepted => { root.accepted(); }
        }
    }

    StandardButton { kind: ok; }
    StandardButton { kind: cancel; }
}

export component CybercurisTray inherits SystemTrayIcon {
    icon: @image-url("../../icons/cybercuris.png");
    tooltip: "cybercuris";

    callback show-window;
    callback quit;

    clicked => { root.show-window(); }

    Menu {
        MenuItem {
            title: "Show cybercuris";
            activated => { root.show-window(); }
        }
        MenuSeparator {}
        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}
